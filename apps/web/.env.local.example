# Life OS AI gateway
# Copy this file to .env.local and fill in your own values.
#
# OpenAI-compatible base URL. Keep the default for OpenAI; change it for a compatible local
# or third-party gateway.
LIFE_OS_AI_BASE_URL=https://api.openai.com/v1

# Private key. Never put this in client code.
LIFE_OS_AI_API_KEY=

# Model name is intentionally configured by you, so the app is not locked to one provider.
LIFE_OS_AI_MODEL=

# Optional private runtime-data directory. Leave empty to use the operating system's
# per-user data directory. Existing installations with apps/web/data keep using it.
LIFE_OS_DATA_DIR=

# Optional account merge rules. Keep real account names only in your local .env.local.
# JSON fields: targetAccountName, sourceInvestmentName, aliases, description.
LIFE_OS_FINANCE_ACCOUNT_MERGES=[]
